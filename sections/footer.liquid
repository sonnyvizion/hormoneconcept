{% liquid
  assign footer_line_alpha = section.settings.line_opacity | divided_by: 100.0
  assign footer_line_color = section.settings.line_color | color_modify: 'alpha', footer_line_alpha
%}

<footer
  class="site-footer site-footer--showcase"
  style="
    --footer-bg: {{ section.settings.bg_color }};
    --footer-line: {{ footer_line_color }};
    --footer-text: {{ section.settings.text_color }};
    --footer-muted: {{ section.settings.muted_color }};
    --footer-input-text: {{ section.settings.input_text_color }};
  "
>
  <div class="site-footer-v2">
    <div class="site-footer-v2__panel">
      <div class="site-footer-v2__newsletter">
        {% if section.settings.newsletter_title != blank %}
          <h2 class="site-footer-v2__heading">{{ section.settings.newsletter_title }}</h2>
        {% endif %}

        {% if section.settings.newsletter_copy != blank %}
          <p class="site-footer-v2__copy">{{ section.settings.newsletter_copy | newline_to_br }}</p>
        {% endif %}

        {% assign newsletter_form_id = 'FooterNewsletterForm-' | append: section.id %}
        {% assign newsletter_cta_label = section.settings.newsletter_cta | replace: '↘', '' | strip %}
        {% form 'customer', id: newsletter_form_id, class: 'site-footer-v2__newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="contact[accepts_marketing]" value="true">
          <div class="site-footer-v2__field-shell">
            <input
              id="FooterNewsletterEmail-{{ section.id }}"
              class="site-footer-v2__email-input"
              type="email"
              name="contact[email]"
              value="{% if customer %}{{ customer.email }}{% endif %}"
              aria-label="{{ section.settings.newsletter_placeholder }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ section.settings.newsletter_placeholder }}"
              required
            >
          </div>

          <button type="submit" class="site-footer-v2__submit">
            <span class="site-footer-v2__submit-label">{{ newsletter_cta_label }}</span>
            <span class="site-footer-v2__submit-arrow" aria-hidden="true">↘</span>
          </button>

          {% if form.posted_successfully? %}
            <p class="site-footer-v2__form-message">{{ section.settings.newsletter_success }}</p>
          {% elsif form.errors %}
            <div class="site-footer-v2__form-message site-footer-v2__form-message--error">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}
        {% endform %}
      </div>

      <div class="site-footer-v2__meta">
        <div class="site-footer-v2__links-row">
          <div class="site-footer-v2__links-group site-footer-v2__links-group--social">
            {% if section.settings.social_title != blank %}
              <h3 class="site-footer-v2__group-title">{{ section.settings.social_title }}</h3>
            {% endif %}

            <ul class="site-footer-v2__links-list" role="list">
              {% for index in (1..5) %}
                {% liquid
                  assign label_setting = 'social_link_' | append: index | append: '_label'
                  assign url_setting = 'social_link_' | append: index | append: '_url'
                  assign social_label = section.settings[label_setting]
                  assign social_url = section.settings[url_setting]
                %}
                {% if social_label != blank %}
                  <li>
                    {% if social_url != blank %}
                      <a href="{{ social_url }}">{{ social_label }}</a>
                    {% else %}
                      <span>{{ social_label }}</span>
                    {% endif %}
                  </li>
                {% endif %}
              {% endfor %}
            </ul>
          </div>

          <div class="site-footer-v2__links-group site-footer-v2__links-group--legal">
            {% if section.settings.legal_title != blank %}
              <h3 class="site-footer-v2__group-title">{{ section.settings.legal_title }}</h3>
            {% endif %}

            <ul class="site-footer-v2__links-list" role="list">
              {% if section.settings.legal_link_1_label != blank %}
                <li>
                  {% if section.settings.legal_link_1_url != blank %}
                    <a href="{{ section.settings.legal_link_1_url }}">{{ section.settings.legal_link_1_label }}</a>
                  {% else %}
                    <span>{{ section.settings.legal_link_1_label }}</span>
                  {% endif %}
                </li>
              {% endif %}

              {% if section.settings.legal_link_2_label != blank %}
                <li>
                  {% if section.settings.legal_link_2_url != blank %}
                    <a href="{{ section.settings.legal_link_2_url }}">{{ section.settings.legal_link_2_label }}</a>
                  {% else %}
                    <span>{{ section.settings.legal_link_2_label }}</span>
                  {% endif %}
                </li>
              {% endif %}

              {% if section.settings.legal_link_3_label != blank %}
                <li>
                  {% if section.settings.legal_link_3_url != blank %}
                    <a href="{{ section.settings.legal_link_3_url }}">{{ section.settings.legal_link_3_label }}</a>
                  {% else %}
                    <span>{{ section.settings.legal_link_3_label }}</span>
                  {% endif %}
                </li>
              {% endif %}
            </ul>
          </div>

          <div class="site-footer-v2__visual">
            {% if section.settings.media_video != blank %}
              {{
                section.settings.media_video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  class: 'site-footer-v2__visual-video'
              }}
            {% elsif section.settings.media_image != blank %}
              {{
                section.settings.media_image
                | image_url: width: 900
                | image_tag:
                  class: 'site-footer-v2__visual-image',
                  loading: 'lazy',
                  alt: section.settings.media_alt
              }}
            {% else %}
              <div class="site-footer-v2__visual-placeholder" aria-hidden="true">VIDEO</div>
            {% endif %}
          </div>
        </div>

        <div class="site-footer-v2__address">
          {% if section.settings.store_title != blank %}
            <p class="site-footer-v2__address-line site-footer-v2__address-line--strong">{{ section.settings.store_title }}</p>
          {% endif %}
          {% if section.settings.store_line_1 != blank %}
            <p class="site-footer-v2__address-line">{{ section.settings.store_line_1 }}</p>
          {% endif %}
          {% if section.settings.store_line_2 != blank %}
            <p class="site-footer-v2__address-line">{{ section.settings.store_line_2 }}</p>
          {% endif %}
          {% if section.settings.store_line_3 != blank %}
            <p class="site-footer-v2__address-line">{{ section.settings.store_line_3 }}</p>
          {% endif %}
          {% if section.settings.store_phone != blank %}
            <p class="site-footer-v2__address-line">{{ section.settings.store_phone }}</p>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="site-footer-v2__brand">
      {% if section.settings.bottom_logo_image != blank %}
        {{
          section.settings.bottom_logo_image
          | image_url: width: 2800
          | image_tag:
            class: 'site-footer-v2__brand-image',
            loading: 'lazy',
            alt: section.settings.bottom_logo_alt | default: shop.name
        }}
      {% else %}
        <span class="site-footer-v2__brand-text">{{ section.settings.bottom_logo_text }}</span>
      {% endif %}
    </div>
  </div>
</footer>

