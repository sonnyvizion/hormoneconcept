<section class="sneaker-cleaning-page sneaker-cleaning-page--simple">
  <div class="container">
    <div class="sneaker-cleaning-page__inner">
      <header class="sneaker-cleaning-page__head">
        {% if section.settings.kicker != blank %}
          <p class="site-page-kicker">[ {{ section.settings.kicker | escape }} ]</p>
        {% endif %}
        {% if section.settings.title != blank %}
          <h1>{{ section.settings.title | escape }}</h1>
        {% endif %}
        {% if section.settings.text != blank %}
          <p>{{ section.settings.text | escape }}</p>
        {% endif %}
      </header>

      <div class="sneaker-cleaning-page__pricing">
        <div class="sneaker-cleaning-page__pricing-head">
          {% if section.settings.pricing_kicker != blank %}
            <p class="site-page-kicker">[ {{ section.settings.pricing_kicker | escape }} ]</p>
          {% endif %}
          {% if section.settings.pricing_title != blank %}
            <h2>{{ section.settings.pricing_title | escape }}</h2>
          {% endif %}
        </div>

        <div class="sneaker-cleaning-page__pricing-grid">
          {% for block in section.blocks %}
            {% if block.type == 'price' %}
              <article class="sneaker-cleaning-page__price-card" {{ block.shopify_attributes }}>
                {% if block.settings.service != blank %}
                  <h3>{{ block.settings.service | escape }}</h3>
                {% endif %}
                {% if block.settings.description != blank %}
                  <p>{{ block.settings.description | escape }}</p>
                {% endif %}
                {% if block.settings.price != blank %}
                  <span>{{ block.settings.price | escape }}</span>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="sneaker-cleaning-page__carousel-wrap">
        <div class="sneaker-cleaning-page__carousel-head">
          <p class="site-page-kicker">[ RESULTATS ]</p>
        </div>

        <div class="sneaker-cleaning-page__carousel" aria-label="Apercu du service nettoyage sneakers">
          {% for block in section.blocks %}
            {% if block.type == 'image' %}
              <article class="sneaker-cleaning-page__image-card" {{ block.shopify_attributes }}>
                <div class="sneaker-cleaning-page__image-media">
                  {% if block.settings.image != blank %}
                    {{
                      block.settings.image
                      | image_url: width: 1400
                      | image_tag:
                        class: 'sneaker-cleaning-page__image',
                        loading: 'lazy',
                        sizes: '(max-width: 749px) 78vw, 34vw',
                        alt: block.settings.alt
                    }}
                  {% else %}
                    <div class="sneaker-cleaning-page__image-placeholder">
                      <span>{{ block.settings.caption | default: 'NETTOYAGE' | escape }}</span>
                    </div>
                  {% endif %}
                </div>

                {% if block.settings.caption != blank %}
                  <p class="sneaker-cleaning-page__caption">{{ block.settings.caption | escape }}</p>
                {% endif %}
              </article>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Sneaker cleaning page",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "SERVICE"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "NETTOYAGE SNEAKERS"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texte",
      "default": "Un nettoyage minutieux pour prolonger la vie de vos paires, raviver les matieres et retrouver une silhouette propre."
    },
    {
      "type": "text",
      "id": "pricing_kicker",
      "label": "Kicker tarifs",
      "default": "TARIFS"
    },
    {
      "type": "text",
      "id": "pricing_title",
      "label": "Titre tarifs",
      "default": "GRILLE TARIFAIRE"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Texte alternatif",
          "default": "Nettoyage sneakers Hormone Concept"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Legende",
          "default": "DETAIL NETTOYAGE"
        }
      ]
    },
    {
      "type": "price",
      "name": "Tarif",
      "settings": [
        {
          "type": "text",
          "id": "service",
          "label": "Service",
          "default": "NETTOYAGE CLASSIQUE"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Nettoyage exterieur, lacets et finition."
        },
        {
          "type": "text",
          "id": "price",
          "label": "Prix",
          "default": "35€"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sneaker cleaning page",
      "blocks": [
        {
          "type": "image",
          "settings": {
            "caption": "AVANT / APRES"
          }
        },
        {
          "type": "image",
          "settings": {
            "caption": "DETAIL MATIERE"
          }
        },
        {
          "type": "image",
          "settings": {
            "caption": "FINITION"
          }
        },
        {
          "type": "price",
          "settings": {
            "service": "NETTOYAGE CLASSIQUE",
            "description": "Sneakers 35€ · Luxe 50€",
            "price": "35€ / 50€"
          }
        },
        {
          "type": "price",
          "settings": {
            "service": "RESTAURATION",
            "description": "Sneakers 50€ · Luxe 70€",
            "price": "50€ / 70€"
          }
        },
        {
          "type": "price",
          "settings": {
            "service": "OPTION EXPRESS",
            "description": "Disponible en 24/48h selon l'heure de depot.",
            "price": "+20€"
          }
        }
      ]
    }
  ]
}
{% endschema %}
