<section class="main-page main-list-collections">
  <div class="container">
    <div class="site-page-shell site-page-shell--catalog">
      <header class="site-page-head">
        <p class="site-page-kicker">[ COLLECTIONS ]</p>
        <h1>{{ section.settings.heading | default: 'NOTRE CATALOGUE' }}</h1>
        {% if section.settings.lead != blank %}
          <p class="site-page-lead">{{ section.settings.lead }}</p>
        {% endif %}
      </header>

      {% assign visible_count = 0 %}
      {% for coll in collections %}
        {% if coll.handle != 'frontpage' %}
          {% assign visible_count = visible_count | plus: 1 %}
        {% endif %}
      {% endfor %}

      {% if visible_count > 0 %}
        <ul class="collection-list" role="list">
          {% assign idx = 0 %}
          {% for coll in collections %}
            {% unless coll.handle == 'frontpage' %}
              {% assign idx = idx | plus: 1 %}
              {% assign idx_label = idx | prepend: '00' | slice: -2, 2 %}
              <li class="collection-list__item">
                <a class="collection-row" href="{{ coll.url }}">
                  <span class="collection-row__index">{{ idx_label }}</span>

                  <span class="collection-row__thumb">
                    {% if coll.image %}
                      {{ coll.image | image_url: width: 200 | image_tag: loading: 'lazy', width: 64, height: 64, alt: coll.title, class: 'collection-row__image' }}
                    {% elsif coll.products.first and coll.products.first.featured_image %}
                      {{ coll.products.first.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', width: 64, height: 64, alt: coll.title, class: 'collection-row__image' }}
                    {% else %}
                      <span class="collection-row__placeholder" aria-hidden="true"></span>
                    {% endif %}
                  </span>

                  <span class="collection-row__title">{{ coll.title | upcase }}</span>

                  <span class="collection-row__count">{{ coll.products_count }} {% if coll.products_count == 1 %}PRODUIT{% else %}PRODUITS{% endif %}</span>

                  <span class="collection-row__arrow" aria-hidden="true">→</span>
                </a>
              </li>
            {% endunless %}
          {% endfor %}
        </ul>
      {% else %}
        <div class="catalog-empty">
          <p>AUCUNE COLLECTION DISPONIBLE.</p>
          <a class="button" href="{{ routes.all_products_collection_url }}">VOIR TOUS LES PRODUITS</a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Main list collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre principal",
      "default": "NOTRE CATALOGUE"
    },
    {
      "type": "text",
      "id": "lead",
      "label": "Sous-titre (optionnel)",
      "default": "EXPLOREZ L'ENSEMBLE DES COLLECTIONS HORMONE CONCEPT."
    }
  ]
}
{% endschema %}
