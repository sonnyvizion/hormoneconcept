{% liquid
  assign fallback_titles = 'VETEMENTS|ACCESSOIRES|SNEAKERS' | split: '|'
  assign fallback_subtitles = 'MODE HOMME|DISPONIBLE|DISPONIBLE' | split: '|'
  assign fallback_cta_labels = 'VETEMENTS|ACCESSOIRES|SNEAKERS' | split: '|'
  assign fallback_tickers = 'VOIR LES COLLECTIONS|VOIR LES COLLECTIONS|VOIR LES COLLECTIONS' | split: '|'
%}

<section
  class="collections-trio"
  style="
    --collections-trio-height: {{ section.settings.desktop_height }};
    --collections-trio-overlay-opacity: {{ section.settings.overlay_opacity | times: 0.01 }};
    --collections-trio-grid-gap: {{ section.settings.grid_gap }}px;
    --collections-trio-line-color: {{ section.settings.line_color }};
    --collections-trio-card-bg: {{ section.settings.card_bg }};
    --collections-trio-ticker-bg: {{ section.settings.ticker_bg }};
    --collections-trio-ticker-color: {{ section.settings.ticker_color }};
    --collections-trio-ticker-duration: {{ section.settings.ticker_duration }}s;
  "
>
  <div class="collections-trio__inner">
    <div class="collections-trio__grid">
      {% for slot in (1..3) %}
        {% liquid
          assign slot_index = forloop.index0
          assign block = section.blocks[slot_index]
          assign collection_ref = blank
          assign desktop_image = blank
          assign mobile_image = blank
          assign image_focus = '50% 50%'
          assign show_ticker = true
          assign title = fallback_titles[slot_index]
          assign subtitle = fallback_subtitles[slot_index]
          assign ticker_text = fallback_tickers[slot_index]
          assign cta_label = fallback_cta_labels[slot_index]
          assign cta_link = ''

          if block != blank
            assign collection_ref = block.settings.collection
            assign title = block.settings.title | default: collection_ref.title | default: fallback_titles[slot_index]
            assign subtitle = block.settings.subtitle | default: fallback_subtitles[slot_index]
            assign ticker_text = block.settings.ticker_text | default: fallback_tickers[slot_index]
            assign cta_label = block.settings.cta_label | default: title
            assign cta_link = block.settings.cta_link | default: collection_ref.url
            assign show_ticker = block.settings.show_ticker
            assign image_focus = block.settings.image_focus | default: '50% 50%'

            if block.settings.image_desktop != blank
              assign desktop_image = block.settings.image_desktop
            elsif collection_ref != blank and collection_ref.image != blank
              assign desktop_image = collection_ref.image
            endif

            if block.settings.image_mobile != blank
              assign mobile_image = block.settings.image_mobile
            else
              assign mobile_image = desktop_image
            endif
          endif

          case slot
            when 1
              assign slot_class = 'collections-trio__item--primary'
            when 2
              assign slot_class = 'collections-trio__item--secondary-top'
            else
              assign slot_class = 'collections-trio__item--secondary-bottom'
          endcase
        %}

        <article class="collections-trio__item {{ slot_class }}" {% if block != blank %}{{ block.shopify_attributes }}{% endif %}>
          <div class="collections-trio__media">
            {% if desktop_image != blank %}
              <picture class="collections-trio__picture" style="--collections-trio-image-focus: {{ image_focus | escape }};">
                {% if mobile_image != blank %}
                  <source media="(max-width: 640px)" srcset="{{ mobile_image | image_url: width: 1400 }}">
                {% endif %}
                {{
                  desktop_image
                  | image_url: width: 2600
                  | image_tag:
                    loading: 'lazy',
                    alt: title,
                    class: 'collections-trio__image'
                }}
              </picture>
            {% else %}
              <div class="collections-trio__placeholder"></div>
            {% endif %}
            <span class="collections-trio__shade"></span>
            <span class="collections-trio__grain"></span>
          </div>

          <span class="collections-trio__corners" aria-hidden="true"></span>

          {% if show_ticker %}
            <div class="collections-trio__ticker-shell">
              <div class="collections-trio__ticker" aria-hidden="true">
                <span class="collections-trio__ticker-track">
                  <span>{{ ticker_text }} - {{ ticker_text }} - {{ ticker_text }} - {{ ticker_text }} -</span>
                  <span>{{ ticker_text }} - {{ ticker_text }} - {{ ticker_text }} - {{ ticker_text }} -</span>
                </span>
              </div>
            </div>
          {% endif %}

          <div class="collections-trio__copy">
            {% if title != blank %}
              <h3>{{ title }}</h3>
            {% endif %}
            {% if subtitle != blank %}
              <p>[ {{ subtitle }} ]</p>
            {% endif %}
          </div>

          {% if cta_label != blank %}
            <div class="collections-trio__footer">
              {% if cta_link != blank %}
                <a class="collections-trio__cta video-hero__availability" href="{{ cta_link }}">
                  <span class="video-hero__availability-bracket" aria-hidden="true">[</span>
                  <span class="video-hero__availability-label">{{ cta_label }}</span>
                  <span class="video-hero__availability-bracket" aria-hidden="true">]</span>
                </a>
              {% else %}
                <span class="collections-trio__cta video-hero__availability">
                  <span class="video-hero__availability-bracket" aria-hidden="true">[</span>
                  <span class="video-hero__availability-label">{{ cta_label }}</span>
                  <span class="video-hero__availability-bracket" aria-hidden="true">]</span>
                </span>
              {% endif %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections trio showcase",
  "settings": [
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Hauteur desktop (vh)",
      "min": 56,
      "max": 98,
      "step": 1,
      "default": 84
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay sombre (%)",
      "min": 0,
      "max": 70,
      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Epaisseur des traits (px)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "ticker_duration",
      "label": "Vitesse ticker (secondes)",
      "min": 16,
      "max": 90,
      "step": 1,
      "default": 42
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Couleur des lignes",
      "default": "#E4EDF5"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Fond des cards",
      "default": "#121A25"
    },
    {
      "type": "color",
      "id": "ticker_bg",
      "label": "Fond ticker",
      "default": "#E8EDF1"
    },
    {
      "type": "color",
      "id": "ticker_color",
      "label": "Texte ticker",
      "default": "#66707A"
    }
  ],
  "blocks": [
    {
      "type": "collection_tile",
      "name": "Tile collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "VETEMENTS"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Sous-titre",
          "default": "MODE HOMME"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "Texte CTA",
          "default": "VOIR LA COLLECTION"
        },
        {
          "type": "url",
          "id": "cta_link",
          "label": "Lien CTA"
        },
        {
          "type": "checkbox",
          "id": "show_ticker",
          "label": "Afficher le ticker",
          "default": true
        },
        {
          "type": "text",
          "id": "ticker_text",
          "label": "Texte ticker",
          "default": "VOIR LES COLLECTIONS"
        },
        {
          "type": "image_picker",
          "id": "image_desktop",
          "label": "Image desktop"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Image mobile"
        },
        {
          "type": "text",
          "id": "image_focus",
          "label": "Position image (CSS object-position)",
          "default": "50% 50%"
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Collections trio showcase",
      "blocks": [
        {
          "type": "collection_tile",
          "settings": {
            "title": "VETEMENTS",
            "subtitle": "MODE HOMME",
            "cta_label": "VETEMENTS",
            "ticker_text": "VOIR LES COLLECTIONS"
          }
        },
        {
          "type": "collection_tile",
          "settings": {
            "title": "ACCESSOIRES",
            "subtitle": "DISPONIBLE",
            "cta_label": "ACCESSOIRES",
            "ticker_text": "VOIR LES COLLECTIONS"
          }
        },
        {
          "type": "collection_tile",
          "settings": {
            "title": "SNEAKERS",
            "subtitle": "DISPONIBLE",
            "cta_label": "SNEAKERS",
            "ticker_text": "VOIR LES COLLECTIONS"
          }
        }
      ]
    }
  ]
}
{% endschema %}
