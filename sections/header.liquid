<header class="site-header">
  <div class="site-header-frame container">
    <a class="header-cell header-brand" href="{{ routes.root_url }}">
      <span class="brand-main">{{ section.settings.brand_main }}</span>
      <span class="brand-sub">{{ section.settings.brand_sub }}</span>
    </a>

    <nav class="header-cell header-menu" aria-label="Menu principal">
      <ul>
        {% for link in section.settings.menu.links %}
          <li><a href="{{ link.url }}">{{ link.title }}</a></li>
        {% endfor %}
      </ul>
    </nav>

    <a class="header-cell header-link header-link--search" href="{{ routes.search_url }}">RECHERCHER</a>
    <a class="header-cell header-link header-link--account" href="{{ routes.account_url }}">COMPTE</a>
    <a class="header-cell header-link header-link--cart" href="{{ routes.cart_url }}">PANIER</a>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "text",
      "id": "brand_main",
      "label": "Marque (ligne 1)",
      "default": "HORMONE"
    },
    {
      "type": "text",
      "id": "brand_sub",
      "label": "Marque (ligne 2)",
      "default": "CONCEPT"
    }
  ]
}
{% endschema %}
