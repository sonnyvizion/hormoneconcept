{% liquid
  assign product_results_count = 0
  assign has_search_term = false

  if search.performed
    if search.terms != blank
      assign has_search_term = true
    endif

    assign product_results_count = search.results_count
  endif
%}

{% paginate search.results by 24 %}
{% assign displayed_product_results_count = search.results | size %}
<section class="main-page main-search">
  <div class="main-search__frame">
    <div class="catalog-page-panel main-search__hero">
      <header class="catalog-page-head catalog-page-head--no-visual main-search__head">
        <div class="catalog-page-head__content">
          <div class="catalog-page-head__heading">
            <p class="site-page-kicker">[ RECHERCHE ]</p>
            <h1 class="catalog-page-head__title">{% if has_search_term %}{{ search.terms | upcase }}{% else %}TROUVER UNE PAIRE{% endif %}</h1>
            <span class="catalog-page-head__brand-pill main-search__product-count">
              {{ product_results_count }} PRODUIT{% if product_results_count != 1 %}S{% endif %}
            </span>
          </div>
          <div class="main-search__panel main-search__panel--search">
            <p class="main-search__panel-kicker">[ RECHERCHER ]</p>
            <form action="{{ routes.search_url }}" method="get" class="site-search-form main-search__form" role="search">
              <input type="hidden" name="options[prefix]" value="last">
              <input type="hidden" name="type" value="product">
              <label class="visually-hidden" for="SearchInput">Recherche</label>
              <input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="RECHERCHER UNE MARQUE, MODELE..." autocomplete="off">
              <button class="button main-search__submit" type="submit">LANCER</button>
            </form>
          </div>
        </div>
      </header>
    </div>

    <div class="catalog-page-body main-search__body">
      <div class="main-search__layout" data-collection-page style="--catalog-cols: 4;">
        <div class="main-search__content">
          {% if search.performed %}
            {% if product_results_count > 0 %}
              {% liquid
                assign product_columns_desktop = 4
                assign product_results_remainder = displayed_product_results_count | modulo: product_columns_desktop
                assign product_placeholder_count = 0
                if product_results_remainder > 0
                  assign product_placeholder_count = product_columns_desktop | minus: product_results_remainder
                endif
              %}
              <section class="main-search__block">
                <div class="main-search__results main-search__results--products catalog-grid" data-catalog-grid>
                  {% for item in search.results %}
                    {% if item.object_type == 'product' %}
                      {% assign result_variant = item.selected_or_first_available_variant %}
                      {% assign hover_image = item.images[1] %}
                      <article class="catalog-grid__card">
                        {% if result_variant != blank %}
                          <form
                            class="catalog-grid__quick-add"
                            data-quick-add-form
                            data-quick-add-title="{{ item.title | escape }}"
                            data-quick-add-image="{% if item.featured_image %}{{ item.featured_image | image_url: width: 320 }}{% endif %}"
                          >
                            <input type="hidden" name="id" value="{{ result_variant.id }}">
                            <script type="application/json" data-quick-add-variants>
                              [
                                {% for variant in item.variants %}
                                  {
                                    "id": {{ variant.id }},
                                    "title": {{ variant.title | json }},
                                    "available": {{ variant.available | json }},
                                    "price": {{ variant.price | money | json }}
                                  }{% unless forloop.last %},{% endunless %}
                                {% endfor %}
                              ]
                            </script>
                            <button
                              type="submit"
                              class="catalog-grid__quick-add-btn"
                              aria-label="Ajouter {{ item.title }} au panier"
                              {% unless result_variant.available %}disabled{% endunless %}
                            >
                              <span class="catalog-grid__quick-add-icon" aria-hidden="true"></span>
                              <span class="catalog-grid__quick-add-label" aria-hidden="true">AJOUTER AU PANIER</span>
                            </button>
                          </form>
                        {% endif %}
                        <a class="catalog-grid__link" href="{{ item.url }}">
                          <div class="catalog-grid__media">
                            {% if item.featured_image %}
                              {{
                                item.featured_image
                                | image_url: width: 1200
                                | image_tag:
                                  loading: 'lazy',
                                  alt: item.title,
                                  class: 'catalog-grid__image catalog-grid__image--primary'
                              }}
                              {% if hover_image %}
                                {{
                                  hover_image
                                  | image_url: width: 1200
                                  | image_tag:
                                    loading: 'lazy',
                                    alt: item.title,
                                    class: 'catalog-grid__image catalog-grid__image--secondary'
                                }}
                              {% endif %}
                            {% else %}
                              <div class="catalog-grid__image catalog-grid__image--placeholder"></div>
                            {% endif %}
                            {% unless item.available %}
                              <span class="catalog-grid__badge">ÉPUISÉ</span>
                            {% endunless %}
                          </div>
                          <div class="catalog-grid__meta">
                            {% render 'brand-mark', brand: item.vendor, class: 'catalog-grid__vendor' %}
                            <h3 class="catalog-grid__title">{{ item.title | upcase }}</h3>
                            <p class="catalog-grid__price">
                              {% if item.price_varies %}
                                À PARTIR DE {{ item.price_min | money }}
                              {% else %}
                                {{ item.price | money }}
                              {% endif %}
                              {% if item.compare_at_price > item.price %}
                                <s class="catalog-grid__compare-price">{{ item.compare_at_price | money }}</s>
                              {% endif %}
                            </p>
                          </div>
                        </a>
                      </article>
                    {% endif %}
                  {% endfor %}

                  {% if product_placeholder_count > 0 %}
                    {% for i in (1..product_placeholder_count) %}
                      <article class="catalog-grid__card search-card--placeholder" aria-hidden="true">
                        <div class="catalog-grid__media search-card__media--placeholder-shell"></div>
                        <div class="catalog-grid__meta search-card__meta--placeholder-shell"></div>
                      </article>
                    {% endfor %}
                  {% endif %}
                </div>
              </section>
            {% endif %}

            {% if paginate.pages > 1 %}
              <nav class="site-pagination" role="navigation" aria-label="Pagination recherche">
                {% if paginate.previous %}
                  <a class="site-pagination__item" href="{{ paginate.previous.url }}">PRÉCÉDENT</a>
                {% endif %}
                {% for part in paginate.parts %}
                  {% if part.is_link %}
                    <a class="site-pagination__item" href="{{ part.url }}">{{ part.title }}</a>
                  {% else %}
                    <span class="site-pagination__item{% if part.title == paginate.current_page %} is-active{% endif %}">{{ part.title }}</span>
                  {% endif %}
                {% endfor %}
                {% if paginate.next %}
                  <a class="site-pagination__item" href="{{ paginate.next.url }}">SUIVANT</a>
                {% endif %}
              </nav>
            {% endif %}

            {% if search.results_count == 0 %}
              <div class="main-search__empty">
                <p class="main-search__empty-kicker">[ VIDE ]</p>
                <p>AUCUN ARTICLE TROUVE POUR "{{ search.terms | upcase }}".</p>
                <p>ESSAIE UNE AUTRE ORTHOGRAPHE, UN NOM DE MARQUE PLUS COURT OU UNE RECHERCHE PLUS LARGE.</p>
              </div>
            {% endif %}
          {% else %}
            <div class="main-search__empty">
              <p class="main-search__empty-kicker">[ DEPART ]</p>
              <p>LANCE UNE RECHERCHE POUR AFFICHER LES PRODUITS LIES.</p>
              <p>MARQUE, MODELE OU SILHOUETTE : TROUVE DIRECTEMENT LA PAIRE RECHERCHEE.</p>
            </div>
          {% endif %}
        </div>
      </div>
    </div>

    <div class="main-search__dock" data-search-dock>
      <form action="{{ routes.search_url }}" method="get" class="site-search-form main-search__form main-search__dock-form" role="search">
        <input type="hidden" name="options[prefix]" value="last">
        <input type="hidden" name="type" value="product">
        <label class="visually-hidden" for="SearchDockInput">Recherche</label>
        <input id="SearchDockInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="RECHERCHER UNE MARQUE, MODELE..." autocomplete="off">
        <button class="button main-search__submit" type="submit">LANCER</button>
      </form>
    </div>
  </div>
</section>
{% endpaginate %}

{% schema %}
{
  "name": "Main search",
  "settings": []
}
{% endschema %}
