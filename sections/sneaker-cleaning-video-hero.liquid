{% liquid
  assign desktop_video = section.settings.video
  assign mobile_video = section.settings.mobile_video
  assign desktop_video_url = section.settings.video_url
  assign mobile_video_url = section.settings.mobile_video_url
%}

<section
  class="cleaning-video-hero"
  style="
    --cleaning-hero-height-desktop: {{ section.settings.height_desktop }}vh;
    --cleaning-hero-height-mobile: {{ section.settings.height_mobile }}svh;
    --cleaning-hero-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --cleaning-hero-content-width: {{ section.settings.content_width }}px;
  "
>
  <div class="cleaning-video-hero__media">
    {% if desktop_video != blank %}
      {{
        desktop_video
        | video_tag:
          class: 'cleaning-video-hero__video cleaning-video-hero__video--desktop',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'auto'
      }}
    {% elsif desktop_video_url != blank %}
      <video
        class="cleaning-video-hero__video cleaning-video-hero__video--desktop"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
      >
        <source src="{{ desktop_video_url | escape }}" type="video/mp4">
      </video>
    {% endif %}

    {% if mobile_video != blank %}
      {{
        mobile_video
        | video_tag:
          class: 'cleaning-video-hero__video cleaning-video-hero__video--mobile',
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'auto'
      }}
    {% elsif mobile_video_url != blank %}
      <video
        class="cleaning-video-hero__video cleaning-video-hero__video--mobile"
        autoplay
        loop
        muted
        playsinline
        preload="auto"
      >
        <source src="{{ mobile_video_url | escape }}" type="video/mp4">
      </video>
    {% endif %}

    {% if desktop_video == blank and desktop_video_url == blank %}
      <div class="cleaning-video-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'cleaning-video-hero__placeholder-svg' }}
      </div>
    {% endif %}
  </div>

</section>

{% stylesheet %}
  .cleaning-video-hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    margin-top: calc(
      (var(--hero-shell-inset) * -1)
      - (var(--site-header-shell-padding) * 2)
      - var(--site-header-height)
      - var(--site-header-gap)
    );
    overflow: hidden;
    isolation: isolate;
    background: #2a2327;
    color: #fff;
  }

  .cleaning-video-hero__media,
  .cleaning-video-hero__gradient {
    position: absolute;
    inset: 0;
  }

  .cleaning-video-hero__media {
    z-index: -2;
  }

  .cleaning-video-hero__video,
  .cleaning-video-hero__placeholder,
  .cleaning-video-hero__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .cleaning-video-hero__video {
    object-fit: cover;
  }

  .cleaning-video-hero__video--mobile {
    display: none;
  }

  .cleaning-video-hero__placeholder-svg {
    object-fit: cover;
    background: #5a5457;
  }

  .cleaning-video-hero__gradient {
    z-index: -1;
    background: linear-gradient(
      to top,
      rgb(22 17 20 / var(--cleaning-hero-overlay-opacity)) 0%,
      rgb(22 17 20 / calc(var(--cleaning-hero-overlay-opacity) * 0.85)) 28%,
      rgb(22 17 20 / calc(var(--cleaning-hero-overlay-opacity) * 0.35)) 68%,
      transparent 100%
    );
    pointer-events: none;
  }

  .cleaning-video-hero__content {
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    min-height: var(--cleaning-hero-height-desktop);
    padding: clamp(28px, 4vw, 64px);
  }

  .cleaning-video-hero__copy {
    width: 85%;
    text-align: left;
  }

  .cleaning-video-hero__copy,
  .cleaning-video-hero__copy * {
    color: #fff;
  }

  .cleaning-video-hero__kicker,
  .cleaning-video-hero__heading,
  .cleaning-video-hero__text,
  .cleaning-video-hero__button {
    margin: 0;
    color: inherit;
  }

  .cleaning-video-hero__kicker {
    padding-bottom: 14px;
    font-size: 10px;
    letter-spacing: 0.22em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .cleaning-video-hero__heading {
    font-size: clamp(34px, 5vw, 76px);
    font-weight: 400;
    letter-spacing: -0.025em;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .cleaning-video-hero__text {
    margin-top: 18px;
    margin-right: auto;
    max-width: 48ch;
    font-family: var(--font-body-clean);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.55;
    text-transform: none;
  }

  .cleaning-video-hero__text > :first-child {
    margin-top: 0;
  }

  .cleaning-video-hero__text > :last-child {
    margin-bottom: 0;
  }

  .cleaning-video-hero__button {
    display: inline-flex;
    gap: 10px;
    margin-top: 24px;
    font-size: 11px;
    letter-spacing: 0.17em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  @media screen and (max-width: 749px) {
    .cleaning-video-hero {
      min-height: 100svh;
    }

    .cleaning-video-hero__video--desktop:has(+ .cleaning-video-hero__video--mobile) {
      display: none;
    }

    .cleaning-video-hero__video--mobile {
      display: block;
    }

    .cleaning-video-hero__content {
      min-height: var(--cleaning-hero-height-mobile);
      padding: 24px 20px 28px;
    }

    .cleaning-video-hero__heading {
      font-size: 34px;
    }

    .cleaning-video-hero__text {
      max-width: 34ch;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero video nettoyage",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "Video Shopify"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "URL MP4 Shopify (secours)",
      "info": "Utilisez ce champ si le selecteur Video Shopify refuse le fichier."
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Video Shopify mobile (optionnelle)"
    },
    {
      "type": "text",
      "id": "mobile_video_url",
      "label": "URL MP4 mobile (secours)"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "SERVICE EN BOUTIQUE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "NETTOYAGE SNEAKERS"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Confiez-nous vos sneakers pour leur redonner une seconde vie.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte du bouton"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien du bouton"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Hauteur sur ordinateur",
      "default": 100
    },
    {
      "type": "range",
      "id": "height_mobile",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Hauteur sur mobile",
      "default": 80
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Opacite du degrade",
      "default": 90
    },
    {
      "type": "range",
      "id": "content_width",
      "min": 300,
      "max": 800,
      "step": 20,
      "unit": "px",
      "label": "Largeur du contenu",
      "default": 560
    }
  ],
  "presets": [
    {
      "name": "Hero video nettoyage"
    }
  ]
}
{% endschema %}
