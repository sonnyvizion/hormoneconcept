{% liquid
  assign row_products_limit = 5
  assign current_collection = product.collections | first
  assign fallback_collection = collections.all
  assign row_label = section.settings.row_label
  if row_label == blank
    assign row_label = 'VOUS AIMEREZ AUSSI'
  endif
  assign row_label = row_label | strip | upcase
  assign view_all_label = section.settings.view_all_label | strip
  if view_all_label == blank
    assign view_all_label = 'TOUT VOIR'
  endif
  assign view_all_label = view_all_label | upcase
  if current_collection != blank
    assign view_all_url = current_collection.url
  else
    assign view_all_url = routes.all_products_collection_url
  endif
%}

<section
  class="collection-slider collection-slider--product-suggestions"
  data-collection-stacks
  style="
    --collection-slider-bg: #D9DBDD;
    --collection-slider-cell-bg: #D9DBDD;
    --collection-slider-ticker-bg: {{ section.settings.ticker_bg_color }};
    --collection-slider-meta-bg: {{ section.settings.meta_bg_color }};
    --collection-slider-card-separator: {{ section.settings.card_separator_color }};
    --collection-slider-row-height: {{ section.settings.row_height }}px;
    --collection-slider-card-width: {{ section.settings.card_width }}px;
    --collection-slider-ticker-duration: {{ section.settings.ticker_duration }}s;
  "
>
  <div class="collection-slider__inner">
    {% for row_number in (1..2) %}
      {% liquid
        assign row_start_index = 1
        assign row_end_index = row_products_limit
        if row_number == 2
          assign row_start_index = row_products_limit | plus: 1
          assign row_end_index = row_products_limit | times: 2
        endif
      %}
      <article class="collection-slider__row{% if row_number == 2 %} collection-slider__row--secondary{% endif %}">
        <div class="collection-slider__overlay">
          {% if row_number == 1 %}
            <div class="collection-slider__badge collection-slider__badge--title">
              <div class="collection-slider__ticker" aria-hidden="true">
                <span class="collection-slider__ticker-track">
                  <span>{{ row_label }} - {{ row_label }} - {{ row_label }} - {{ row_label }} -</span>
                  <span>{{ row_label }} - {{ row_label }} - {{ row_label }} - {{ row_label }} -</span>
                </span>
              </div>
            </div>
          {% endif %}

          <div class="collection-slider__overlay-right">
            <div class="collection-slider__badge collection-slider__badge--controls">
              <button class="collection-slider__control" type="button" data-stack-prev aria-label="Produits precedents">
                <span aria-hidden="true">&lt;</span>
              </button>
              <button class="collection-slider__control" type="button" data-stack-next aria-label="Produits suivants">
                <span aria-hidden="true">&gt;</span>
              </button>
            </div>

            {% if row_number == 1 %}
              <a class="collection-slider__badge collection-slider__badge--view-all" href="{{ view_all_url }}">
                <div class="collection-slider__ticker collection-slider__ticker--reverse" aria-hidden="true">
                  <span class="collection-slider__ticker-track">
                    <span>{{ view_all_label }} - {{ view_all_label }} - {{ view_all_label }} - {{ view_all_label }} -</span>
                    <span>{{ view_all_label }} - {{ view_all_label }} - {{ view_all_label }} - {{ view_all_label }} -</span>
                  </span>
                </div>
              </a>
            {% endif %}
          </div>
        </div>

        <div class="collection-slider__fixed-quick-adds" aria-hidden="false">
          {% for slot in (1..5) %}
            <button
              class="collection-slider__fixed-quick-add-button"
              type="button"
              data-fixed-quick-add-slot="{{ forloop.index0 }}"
              aria-label="Ajouter au panier"
            >
              <span class="collection-slider__fixed-quick-add-icon" aria-hidden="true">+</span>
              <span class="collection-slider__fixed-quick-add-label" aria-hidden="true">AJOUTER AU PANIER</span>
              <span class="collection-slider__fixed-quick-add-sold-out" aria-hidden="true">ÉPUISÉ</span>
            </button>
          {% endfor %}
        </div>

        <div class="collection-slider__swipe-hints" aria-hidden="true">
          <span class="collection-slider__swipe-hint collection-slider__swipe-hint--left"></span>
          <span class="collection-slider__swipe-hint collection-slider__swipe-hint--right"></span>
        </div>

        <div class="collection-slider__viewport" data-stack-viewport>
          <div class="collection-slider__track" data-stack-track data-loop-size="{{ row_products_limit }}">
            {% for pass in (1..3) %}
              {% liquid
                assign ranked_handles = '|'
                assign ranked_index = 0
                assign rendered_count = 0
              %}

              {% if current_collection != blank %}
                {% for p in current_collection.products %}
                  {% liquid
                    assign handle_key = '|' | append: p.handle | append: '|'
                    assign same_vendor = false
                    assign same_type = false
                    if p.vendor == product.vendor
                      assign same_vendor = true
                    endif
                    if p.type == product.type
                      assign same_type = true
                    endif
                  %}
                  {% if p.id == product.id or ranked_handles contains handle_key or same_vendor == false or same_type == false %}{% continue %}{% endif %}
                  {% liquid
                    assign ranked_handles = ranked_handles | append: p.handle | append: '|'
                    assign ranked_index = ranked_index | plus: 1
                  %}
                  {% if ranked_index < row_start_index %}{% continue %}{% endif %}
                  {% if ranked_index > row_end_index %}{% break %}{% endif %}
                  {% assign rendered_count = rendered_count | plus: 1 %}
                  {% render 'collection-slider-product-card', card_product: p %}
                {% endfor %}

                {% if ranked_index < row_end_index %}
                  {% for p in current_collection.products %}
                    {% liquid
                      assign handle_key = '|' | append: p.handle | append: '|'
                      assign same_vendor = false
                      if p.vendor == product.vendor
                        assign same_vendor = true
                      endif
                    %}
                    {% if p.id == product.id or ranked_handles contains handle_key or same_vendor == false %}{% continue %}{% endif %}
                    {% liquid
                      assign ranked_handles = ranked_handles | append: p.handle | append: '|'
                      assign ranked_index = ranked_index | plus: 1
                    %}
                    {% if ranked_index < row_start_index %}{% continue %}{% endif %}
                    {% if ranked_index > row_end_index %}{% break %}{% endif %}
                    {% assign rendered_count = rendered_count | plus: 1 %}
                    {% render 'collection-slider-product-card', card_product: p %}
                  {% endfor %}
                {% endif %}

                {% if ranked_index < row_end_index %}
                  {% for p in current_collection.products %}
                    {% liquid
                      assign handle_key = '|' | append: p.handle | append: '|'
                      assign same_type = false
                      if p.type == product.type
                        assign same_type = true
                      endif
                    %}
                    {% if p.id == product.id or ranked_handles contains handle_key or same_type == false %}{% continue %}{% endif %}
                    {% liquid
                      assign ranked_handles = ranked_handles | append: p.handle | append: '|'
                      assign ranked_index = ranked_index | plus: 1
                    %}
                    {% if ranked_index < row_start_index %}{% continue %}{% endif %}
                    {% if ranked_index > row_end_index %}{% break %}{% endif %}
                    {% assign rendered_count = rendered_count | plus: 1 %}
                    {% render 'collection-slider-product-card', card_product: p %}
                  {% endfor %}
                {% endif %}

                {% if ranked_index < row_end_index %}
                  {% for p in current_collection.products %}
                    {% liquid
                      assign handle_key = '|' | append: p.handle | append: '|'
                    %}
                    {% if p.id == product.id or ranked_handles contains handle_key %}{% continue %}{% endif %}
                    {% liquid
                      assign ranked_handles = ranked_handles | append: p.handle | append: '|'
                      assign ranked_index = ranked_index | plus: 1
                    %}
                    {% if ranked_index < row_start_index %}{% continue %}{% endif %}
                    {% if ranked_index > row_end_index %}{% break %}{% endif %}
                    {% assign rendered_count = rendered_count | plus: 1 %}
                    {% render 'collection-slider-product-card', card_product: p %}
                  {% endfor %}
                {% endif %}
              {% endif %}

              {% if ranked_index < row_end_index and fallback_collection != blank %}
                {% for p in fallback_collection.products %}
                  {% liquid
                    assign handle_key = '|' | append: p.handle | append: '|'
                  %}
                  {% if p.id == product.id or ranked_handles contains handle_key %}{% continue %}{% endif %}
                  {% liquid
                    assign ranked_handles = ranked_handles | append: p.handle | append: '|'
                    assign ranked_index = ranked_index | plus: 1
                  %}
                  {% if ranked_index < row_start_index %}{% continue %}{% endif %}
                  {% if ranked_index > row_end_index %}{% break %}{% endif %}
                  {% assign rendered_count = rendered_count | plus: 1 %}
                  {% render 'collection-slider-product-card', card_product: p %}
                {% endfor %}
              {% endif %}

              {% liquid
                assign missing_cards = row_products_limit | minus: rendered_count
              %}
              {% if missing_cards > 0 %}
                {% for i in (1..missing_cards) %}
                  <article class="collection-slider__card collection-slider__card--placeholder" data-product-card>
                    <div class="collection-slider__quick-add">
                      <button class="collection-slider__quick-add-button" type="button" disabled aria-hidden="true">
                        <span aria-hidden="true">+</span>
                      </button>
                    </div>
                    <div class="collection-slider__product-link">
                      <div class="collection-slider__media">
                        <div class="collection-slider__product-image collection-slider__product-image--placeholder"></div>
                      </div>
                      <div class="collection-slider__meta">
                        <p class="collection-slider__brand">ORIGINAL</p>
                        <h3>PRODUIT EXEMPLE {{ i }}</h3>
                        <p class="collection-slider__price">{{ 12000 | money }}</p>
                      </div>
                    </div>
                  </article>
                {% endfor %}
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </article>
    {% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Suggestions produits",
  "settings": [
    {
      "type": "text",
      "id": "row_label",
      "label": "Texte defilant",
      "default": "VOUS AIMEREZ AUSSI"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texte bouton tout voir",
      "default": "TOUT VOIR"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Fond section",
      "default": "#E9EBEB"
    },
    {
      "type": "color",
      "id": "ticker_bg_color",
      "label": "Fond cadres ticker",
      "default": "#EFF0F0"
    },
    {
      "type": "color",
      "id": "meta_bg_color",
      "label": "Fond meta produit",
      "default": "#EFF0F0"
    },
    {
      "type": "color",
      "id": "card_separator_color",
      "label": "Couleur separateur cartes",
      "default": "#EFF0F0"
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "Hauteur du slider",
      "min": 280,
      "max": 520,
      "step": 10,
      "default": 380,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "card_width",
      "label": "Largeur d'une carte produit",
      "min": 180,
      "max": 340,
      "step": 10,
      "default": 260,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "ticker_duration",
      "label": "Vitesse texte defilant",
      "min": 16,
      "max": 80,
      "step": 2,
      "default": 34,
      "unit": "s"
    }
  ],
  "presets": [
    {
      "name": "Suggestions produits"
    }
  ]
}
{% endschema %}
