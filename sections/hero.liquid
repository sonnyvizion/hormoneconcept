<section class="hero">
  <div class="container hero-content">
    <p class="hero-kicker">NOUVELLE SAISON</p>
    <h1>{{ section.settings.title }}</h1>
    <p>{{ section.settings.subtitle }}</p>

    {% if section.settings.button_label != blank %}
      <a class="button" href="{{ section.settings.button_link }}">
        {{ section.settings.button_label }}
      </a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Hormone Concept"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Mode premium street & lifestyle"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte bouton",
      "default": "Voir la collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien bouton"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
