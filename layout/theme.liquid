<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>
      {{ page_title }}
      {% if current_tags %} · {{ current_tags | join: ', ' }}{% endif %}
      {% if current_page != 1 %} · Page {{ current_page }}{% endif %}
      {% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}
    </title>

    {{ content_for_header }}

    <link rel="icon" href="{{ 'favicon-hormone.svg' | asset_url }}" type="image/svg+xml">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {% # theme-check-disable RemoteAsset %}
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@300;400&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet">
    {% # theme-check-enable RemoteAsset %}

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'paragraph-font.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'lenis.min.js' | asset_url }}" defer></script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
    <script src="{{ 'search-kicker-scramble.js' | asset_url }}" defer></script>
  </head>
  <body class="template-{{ template | replace: '.', '-' | handle }}">
    {% if request.page_type == 'index' %}
      {% render 'site-loader' %}
    {% endif %}

    <a class="skip-link" href="#main-content">Aller au contenu</a>

    {% section 'reassurance-bar' %}
    {% section 'header' %}

    <main id="main-content" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
  </body>
</html>
