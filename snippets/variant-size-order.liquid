{%- comment -%}
  Renvoie les index de variantes tries par taille croissante. Le tri ne
  s'applique que si chaque variante porte une taille numerique ; sinon, l'ordre
  configure dans Shopify est conserve (vetements, couleurs, etc.).
{%- endcomment -%}
{%- liquid
  assign order_keys = ''
  assign numeric_count = 0

  for variant in product.variants
    assign current_index = forloop.index0
    assign size_value = 0
    assign title_parts = variant.title | downcase | replace: ',', '.' | split: ' '

    for part in title_parts
      assign candidate = part | plus: 0
      if candidate > 0
        assign size_value = candidate
        assign following_part = title_parts[forloop.index]
        if following_part == '1/3'
          assign size_value = size_value | plus: 0.333
        elsif following_part == '1/2'
          assign size_value = size_value | plus: 0.5
        elsif following_part == '2/3'
          assign size_value = size_value | plus: 0.667
        endif
        break
      endif
    endfor

    if size_value > 0
      assign numeric_count = numeric_count | plus: 1
    endif

    assign sort_key = size_value | times: 1000 | round
    assign padded_key = '00000000' | append: sort_key | slice: -8, 8
    assign padded_index = '0000' | append: current_index | slice: -4, 4
    assign order_keys = order_keys | append: ' ' | append: padded_key | append: padded_index
  endfor

  assign order_list = order_keys | strip | split: ' '
  if numeric_count == product.variants.size
    assign order_list = order_list | sort
  endif
-%}
{%- for entry in order_list -%}
  {{- entry | slice: 8, 4 | plus: 0 -}}
  {%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
